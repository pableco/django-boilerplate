# Copiar como .env para desarrollo local
SECRET_KEY=cambia-esto-por-una-clave-secreta-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: ruta del fichero SQLite. En Railway no hace falta, se usa el
# volumen automáticamente (RAILWAY_VOLUME_MOUNT_PATH).
# SQLITE_PATH=/ruta/a/db.sqlite3

# Superusuario que se crea en el primer arranque si no existe ninguno
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=cambia-esto
